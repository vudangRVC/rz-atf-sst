/dts-v1/;

/ {
	compatible = "renesas,r9a07g044l2", "renesas,r9a07g044";
	model = "Renesas RZG2L board";
	#address-cells = <2>;
	#size-cells = <2>;

	/* clock can be either from exclk or crystal oscillator (XIN/XOUT) */
	extal_clk: extal {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x00>;
		phandle = <0x03>;
	};

	g2l: soc {
		compatible = "simple-bus";
		soc_id = <0x1>;
		bl2_limit = <0x0002F000>;
		enable_cold_boot = <0>;
		spirom_fip_base = <0x2001D200>;
		spirom_fip_size = <0xFFE2E00>;
		emmc_fip_base = <0x00020000>;
		emmc_fip_size = <0x001DFFFF>;
		sd_fip_base = <0x00010000>;
		sd_fip_size = <0x001DFFFF>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		scif0: serial@1004b800 {
			compatible = "renesas,scif-r9a07g044";
			reg = <0x00 0x1004b800 0x00 0x400>;
			interrupt-names = "eri", "rxi", "txi", "bri", "dri", "tei";
			clocks = <&extal_clk>;
			clock-names = "fck";
			power-domains = <&cpg>;
			status = "disabled";

			uart_inck_hz = <100000000>;
			uart_baudrate = <115200>;
		};

		spi0: spi@10060000 {
			compatible = "renesas,r9a07g044-rpc-if", "renesas,rzg2l-rpc-if";
			reg = <0x00 0x10060000 0x00 0x10000>,
			      <0x00 0x20000000 0x00 0x10000000>,
			      <0x00 0x10070000 0x00 0x10000>;
			reg-names = "regs", "dirmap", "wbuf";
			power-domains = <&cpg>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			/* SPI type
			 * [0] = SPI Multi IO
			 * [1] = XSPI
			 */
			spi_type = <0>;

			/* SPI Multi IO specific settings */
			spim_phycnt = <0x00000260>;
			spim_phyoffset1 = <0x31511144>;
			spim_phyoffset2 = <0x00000431>;
			spim_cmncr = <0x0155a200>;
			spim_ssldr = <0x00030303>;
			spim_drcr = <0x001f0300>;
			spim_drcmr = <0x00eb0000>;
			spim_drear = <0x00000000>;
			spim_drenr = <0x0222c780>;
			spim_drdmcr = <0x00000003>;
			spim_drdrenr = <0x00000000>;
		};

		cpg: clock-controller@11010000 {
			compatible = "renesas,r9a07g044-cpg";
			reg = <0 0x11010000 0 0x10000>;
			clocks = <&extal_clk>;
			clock-names = "extal";
			#clock-cells = <2>;
			#reset-cells = <1>;
			#power-domain-cells = <0>;

			cpg_type = <0>;
			cpg_selector_on_off = <1>;
			cpg_early_setup = <1>;
			cpg_mstop_setup = <0>;
			cpg_rst_ddr_opt = <0x00000000>;

			cpg_clk_on_tbl = <
				0x0504 0x00030000
				0x0684
				0
				
				0x0520 0x00010000
				0x06A0
				0
				
				0x052C 0x00030003
				0x06AC
				0
				
				0x0534 0x00060000
