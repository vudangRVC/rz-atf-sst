				1 0x1C48 0x00000000
				1 0x1448 0x01010101
				1 0x1848 0x01010101
			>;
		};

		ddr: memory@40000000 {
			compatible = "renesas,r9a07g044-sdram";
			reg = <0 0x40000000 0 0x10000>;

			/* DDR type
			 * [0] = DDR4
			 * [1] = LPDDR4
			 */
			ddr_type = <0x00000000>;

			lp_cmd_offset = <0x0>;

			ddrmc_r000 = <0x00000000>;
