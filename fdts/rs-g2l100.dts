				1 0x1060 0x00020202
				1 0x1C60 0x00000000
				1 0x1460 0x00010000
			>;

			pfc_sd_reg_tbl = <
				1 0x0222 0x0003
				1 0x0488 0x00000003
				1 0x1030 0x00020202
				1 0x1C30 0x00000000
				1 0x1430 0x00010101
				1 0x1830 0x00000100

				0 0 0
