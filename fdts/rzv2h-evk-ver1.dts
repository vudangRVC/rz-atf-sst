/*
 * Device Tree Source for the RZ/V2H EVK Version 1 board
 *
 * Copyright (C) 2023 Renesas Electronics Corp.
 */

/dts-v1/;

/ {
	compatible = "renesas,r9a09g057h4-dev", "renesas,r9a09g057h4", "renesas,r9a09g057";
	model = "Renesas EVK Version 1 based on r9a09g057h4";
	#address-cells = <2>;
	#size-cells = <2>;

	/* clock can be either from exclk or crystal oscillator (XIN/XOUT) */
	extal_clk: extal-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	/* et0_txc_tx_clk clock input */
	et0_txc_tx_clk: et0_txc_tx_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	/* et0_rxc_rx_clk clock input */
	et0_rxc_rx_clk: et0_rxc_rx_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	/* et1_txc_tx_clk clock input */
	et1_txc_tx_clk: et1_txc_tx_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	/* et1_rxc_rx_clk clock input */
	et1_rxc_rx_clk: et1_rxc_rx_clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		/* This value must be overridden by the board */
		clock-frequency = <0>;
	};

	v2h: soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;

		sysc: system-controller@10430000 {
			compatible = "renesas,r9a09g057-sysc";
			reg = <0 0x10430000 0 0x10000>;
			syc_inck_hz = <24000000>;
		};

		timer: system-timer@14010000 {
			compatible = "renesas,r9a09g057-timer";
			reg = <0 0x14010000 0 0x10000>;
			syc_timer_mul = <1000000>;
			syc_timer_offset = <0x020>;
		};

		cpg: clock-controller@10420000 {
			compatible = "renesas,r9a09g057-cpg";
			reg = <0 0x10420000 0 0x10000>;
			clocks = <&extal_clk>,
				 <&et0_txc_tx_clk>, <&et0_rxc_rx_clk>,
				 <&et1_txc_tx_clk>, <&et1_rxc_rx_clk>;
			clock-names = "extal",
				      "et0_txc_tx_clk", "et0_rxc_rx_clk",
				      "et1_txc_tx_clk", "et1_rxc_rx_clk";
			#clock-cells = <2>;
			#reset-cells = <1>;
			#power-domain-cells = <0>;

			csdiv0-offset = <0x500>;
			csdiv1-offset = <0x504>;
		};

		cpg_pll: cpg_pll@10420000 {
			compatible = "renesas,r9a09g057-pll";
			reg = <0 0x10420000 0 0x10000>;
			#clock-cells = <2>;
			#reset-cells = <1>;
			#power-domain-cells = <0>;
			cm33 {
				stby-addr = <0x0>; 
				stby-val  = <0x0>;

				clk1-addr = <0x0>; 
				clk1-val  = <0x00>;

				clk2-addr = <0x0>; 
				clk2-val  = <0x0>;

				mon-addr = <0x10>;
				mon-val  = <0x0>;
			};

			cln {
				stby-addr = <0x0>; 
				stby-val  = <0x0>;

				clk1-addr = <0x0>; 
				clk1-val  = <0x00>;

				clk2-addr = <0x0>; 
				clk2-val  = <0x0>;

				mon-addr = <0x30>;
				mon-val  = <0x0>;
			};

			dty {
				stby-addr = <0x0>; 
				stby-val  = <0x0>;

				clk1-addr = <0x0>; 
				clk1-val  = <0x00>;

				clk2-addr = <0x0>; 
				clk2-val  = <0x0>;

				mon-addr = <0x50>;
				mon-val  = <0x0>;
			};

			ca55 {
				stby-addr = <0x0>; 
				stby-val  = <0x0>;

				clk1-addr = <0x0>; 
				clk1-val  = <0x00>;

				clk2-addr = <0x0>; 
				clk2-val  = <0x0>;

				mon-addr = <0x70>;
				mon-val  = <0x0>;
			};

			vdo {
				stby-addr = <0x0>; 
				stby-val  = <0x0>;

				clk1-addr = <0x0>; 
				clk1-val  = <0x00>;

				clk2-addr = <0x0>; 
				clk2-val  = <0x0>;

				mon-addr = <0x90>;
				mon-val  = <0x0>;
			};

			eth {
				stby-addr = <0xA0>;
				stby-val  = <0x00010001>;
				clk1-addr = <0x0>; 

				clk1-val  = <0x00>;

				clk2-addr = <0x0>; 
				clk2-val  = <0x0>;

				mon-addr = <0xB0>;
				mon-val  = <0x0>;
			};

			dsi {
				stby-addr = <0xC0>;
				stby-val  = <0x00010001>;

				clk1-addr = <0xC4>;
				clk1-val  = <0x00003182>;

				clk2-addr = <0xC8>;
				clk2-val  = <0x000C1803>;

				mon-addr = <0xD0>;
				mon-val  = <0x0>;
			};

			gpu {
				stby-addr = <0x120>;
				stby-val  = <0x00050001>;

				clk1-addr = <0x124>;
				clk1-val  = <0x00003482>;

				clk2-addr = <0x128>;
				clk2-val  = <0x000C1A01>;

				mon-addr = <0x130>;
				mon-val  = <0x0>;
			};

			drp {
				stby-addr = <0x0>; 
				stby-val  = <0x0>;

				clk1-addr = <0x0>; 
				clk1-val  = <0x00>;

				clk2-addr = <0x0>; 
				clk2-val  = <0x0>;

				mon-addr = <0x150>; 
				mon-val  = <0x0>;
			};
		};

		cpg_clock_on: cpg-clk-config@10420000 {
			compatible = "renesas,r9a09g057-clk-on";
			#clock-cells = <2>;
			#reset-cells = <1>;
			#power-domain-cells = <0>;
			reg = <0 0x10520000 0 0x10000>;

			clocks-config {
				cr8_part1 {
					config = <0x0600 0x0000e000 0x0800 0x0000e000 0>;
				};
				cr8_part2 {
					config = <0x0604 0x00000003 0x0804 0x00030000 0>;
				};
				mhu {
					config = <0x060c 0x00000001 0x0804 0x00010000 0>;
				};
				dmac_part1 {
					config = <0x0600 0x0000001e 0x0800 0x0000001e 0>;
				};
				dmac_part2 {
					config = <0x063c 0x00000100 0x081c 0x01000000 0>;
				};
				ostm {
					config = <0x0610 0x000007f8 0x0808 0x000007f8 0>;
				};
				gpt {
					config = <0x060c 0x00000006 0x0804 0x00060000 0>;
				};
				poeg {
					config = <0x060c 0x000007f8 0x0804 0x07f80000 0>;
				};
				wdt_part1 {
					config = <0x0610 0x00000e00 0x0808 0x00000e00 0>;
				};
				wdt_part2 {
					config = <0x0614 0x00000007 0x0808 0x00070000 0>;
				};
				spi_part1 {
					config = <0x0614 0x00001ff0 0x0808 0x1ff00000 0>;
				};
				spi_part2 {
					config = <0x0624 0x00008000 0x0810 0x80000000 0>;
				};
				spi_part3 {
					config = <0x0628 0x00000003 0x0814 0x00000007 0>;
				};
				sdhi {
					config = <0x0628 0x00007ff8 0x0814 0x00007ff8 0>;
				};
				gpu {
					config = <0x063c 0x00000007 0x081c 0x00070000 0>;
				};
				scaling {
					config = <0x0638 0x000000c0 0x081c 0x000000c0 0>;
				};
				cru_part1 {
					config = <0x0634 0x0000fffc 0x0818 0xfffc0000 0>;
				};
				cru_part2 {
					config = <0x0638 0x00000003 0x081c 0x00000003 0>;
				};
				dsi {
					config = <0x0638 0x00001f00 0x081c 0x00001f00 0>;
				};
				lcdc {
					config = <0x0638 0x0000e000 0x081c 0x0000e000 0>;
				};
				ssi_part1 {
					config = <0x063c 0x00000020 0x081c 0x00200000 0>;
				};
				ssi_part2 {
					config = <0x0660 0x000007ff 0x081c 0x00000000 0>;
				};
				usb2 {
					config = <0x062c 0x000000f8 0x0814 0x00f80000 0>;
				};
				usb3_part1 {
					config = <0x0628 0x00008000 0x0814 0x00008000 0>;
				};
				usb3_part2 {
					config = <0x062c 0x00000007 0x0814 0x00070000 0>;
				};
				i2c {
					config = <0x0624 0x00000ff8 0x0810 0x0ff80000 0>;
				};
				scif {
					config = <0x0620 0x00008000 0x0810 0x00008000 0>;
				};
				sci_part1 {
					config = <0x0614 0x0000e000 0x0808 0xe0000000 0>;
				};
				sci_part2 {
					config = <0x0618 0x0000ffff 0x080c 0x0000ffff 0>;
				};
				sci_part3 {
					config = <0x061c 0x0000ffff 0x080c 0xffff0000 0>;
				};
				sci_part4 {
					config = <0x0620 0x00007fff 0x0810 0x00007fff 0>;
				};
				can {
					config = <0x0624 0x00007000 0x0810 0x70000000 0>;
				};
				adc_part1 {
					config = <0x0640 0x00000180 0x0820 0x00000180 0>;
				};
				crc {
					config = <0x0600 0x00000040 0x0800 0x00000040 0>;
				};
				cmtw_part1 {
					config = <0x060c 0x0000f800 0x0804 0xf8000000 0>;
				};
				cmtw_part2 {
					config = <0x0610 0x00000007 0x0808 0x00000007 0>;
				};
				rtc {
					config = <0x0614 0x00000008 0x0808 0x00080000 0>;
				};
				i3c {
					config = <0x0624 0x00000007 0x0810 0x00070000 0>;
				};
				gbeth_part1 {
					config = <0x062c 0x0000ff00 0x0814 0x75000000 0>;
				};
				gbeth_part2 {
					config = <0x0630 0x0000000f 0x0818 0x0000000d 0>;
				};
				pcie_part1 {
					config = <0x0630 0x00000030 0x0818 0x00000030 0>;
				};
				isp {
					config = <0x0638 0x0000003c 0x081c 0x0000003c 0>;
				};
				vcd {
					config = <0x063c 0x00000018 0x081c 0x00180000 0>;
				};
				scu {
					config = <0x063c 0x000000c0 0x081c 0x00c00000 0>;
				};
				adg {
					config = <0x063c 0x00003e00 0x081c 0x06000000 0>;
				};
				spdif_part1 {
					config = <0x063c 0x0000c000 0x081c 0xc0000000 0>;
				};
				spdif_part2 {
					config = <0x0640 0x00000001 0x0820 0x00000001 0>;
				};
				pdm {
					config = <0x0640 0x0000007e 0x0820 0x0000007e 0>;
				};
				tsu {
					config = <0x0640 0x00000600 0x0820 0x00000600 0>;
				};
				drp {
					config = <0x0644 0x0000007f 0x0820 0x007f0000 0>;
				};
			};
		};
	};
};
