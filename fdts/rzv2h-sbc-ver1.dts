				0x00000274 0x00000003 0x00000000
			>;
		};

		syc: system-counter@14010000 {
			compatible = "renesas,r9a09g057-syc";
			reg = <0 0x14010000 0 0x10000>;

			syc_inck_hz = <24000000>;
		};

		cpg: clock-controller@10420000 {
			compatible = "renesas,r9a09g057-cpg";
			reg = <0 0x10420000 0 0x10000>;
			clocks = <&extal_clk>,
				 <&et0_txc_tx_clk>, <&et0_rxc_rx_clk>,
				 <&et1_txc_tx_clk>, <&et1_rxc_rx_clk>;
			clock-names = "extal",
				      "et0_txc_tx_clk", "et0_rxc_rx_clk",
				      "et1_txc_tx_clk", "et1_rxc_rx_clk";
			#clock-cells = <2>;
			#reset-cells = <1>;
			#power-domain-cells = <0>;

			cpg_type 			= <1>;
			cpg_selector_on_off = <0>;
			cpg_early_setup		= <0>;
			cpg_mstop_setup		= <1>;

